# Идентификатор Google Таблицы, ссылка на неё или id файла Excel (.xlsx) на Диске.
# Таблицу нужно открыть сервисному аккаунту из JSON-ключа (роль «Редактор»).
GOOGLE_SPREADSHEET_ID=

# Имя листа. Если пусто, точка входа читает все листы.
GOOGLE_SHEET_NAME=

# Путь к JSON-ключу. Если пусто, берётся единственный ключ в папке проекта.
GOOGLE_CREDENTIALS_PATH=

# Папка Диска: ссылка или идентификатор.
# Сюда личный аккаунт кладёт новые документы и таблицы.
# Если пусто, чтение сервисным аккаунтом показывает все доступные ему файлы.
GOOGLE_DRIVE_FOLDER_ID=

# JSON OAuth-клиента (тип installed). Если пусто, берётся единственный client_secret_*.json.
GOOGLE_OAUTH_CLIENT_SECRETS=

# Файл, куда сохраняется токен пользователя после входа в браузере.
GOOGLE_OAUTH_TOKEN_PATH=google_oauth_token.json
